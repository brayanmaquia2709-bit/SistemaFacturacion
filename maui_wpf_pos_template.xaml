<!-- 
  =============================================================================
  SISTEMA FACTURACIÓN POS - TEMA OSCURO MINIMALISTA EMPRESARIAL (WPF / .NET MAUI)
  =============================================================================
-->
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="POS Terminal Enterprise" Background="#121214">

    <!-- RECURSOS Y ESTILOS DE LA PALETA DE COLORES -->
    <Page.Resources>
        <SolidColorBrush x:Key="BgMain" Color="#121214" />
        <SolidColorBrush x:Key="BgSurface" Color="#1E1E24" />
        <SolidColorBrush x:Key="BgCard" Color="#25252E" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#2D2D38" />
        <SolidColorBrush x:Key="AccentEmerald" Color="#10B981" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F9FAFB" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF" />

        <!-- Estilo de Contenedores Tipo Tarjeta (Border-Radius 12) -->
        <Style x:Key="PosCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Estilo Botón Focal "Generar Factura" -->
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentEmerald}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="0,16" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- GRID PRINCIPAL DE 4 ZONAS -->
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" /> <!-- Izquierda: Cliente + Catálogo -->
            <ColumnDefinition Width="20" /> <!-- Separador -->
            <ColumnDefinition Width="5*" /> <!-- Derecha: Carrito + Total Focal -->
        </Grid.ColumnDefinitions>

        <!-- COLUMNA IZQUIERDA -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- ZONA 1: Cliente -->
                <RowDefinition Height="15" />
                <RowDefinition Height="*" />    <!-- ZONA 2: Catálogo/Inventario -->
            </Grid.RowDefinitions>

            <!-- ZONA 1: TARJETA DE CLIENTE -->
            <Border Grid.Row="0" Style="{StaticResource PosCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CLIENTE ASIGNADO" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="Cliente General / Mostrador" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" Margin="0,2,0,0" />
                        <TextBlock Text="NIT / RFC: 222222222222" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Cambiar Cliente" Background="#10B981" Foreground="White" Padding="12,6" />
                </Grid>
            </Border>

            <!-- ZONA 2: CATÁLOGO DE PRODUCTOS EN CUADRÍCULA -->
            <Border Grid.Row="2" Style="{StaticResource PosCardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CATÁLOGO DE PRODUCTOS" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,10" />
                    <!-- Grid Táctil de Productos -->
                    <UniformGrid Columns="3" VerticalAlignment="Top">
                        <!-- Ejemplo de Tarjeta de Producto -->
                        <Border Style="{StaticResource PosCardStyle}" Background="{StaticResource BgCard}" Margin="4" Height="100">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🖨️ Impresora POS" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12" />
                                <TextBlock Text="$120.00" Foreground="{StaticResource AccentEmerald}" FontWeight="Bold" FontSize="14" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- COLUMNA DERECHA -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />    <!-- ZONA 3: Carrito -->
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" /> <!-- ZONA 4: Total & Pago (Punto Focal) -->
            </Grid.RowDefinitions>

            <!-- ZONA 3: CARRITO DE COMPRAS -->
            <Border Grid.Row="0" Style="{StaticResource PosCardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="🛒 ÍTEMS EN CARRITO" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,10" />
                    <ListBox Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" />
                </DockPanel>
            </Border>

            <!-- ZONA 4: CONDICIONES DE PAGO Y TOTAL FOCAL -->
            <Border Grid.Row="2" Style="{StaticResource PosCardStyle}">
                <StackPanel>
                    <!-- PUNTO FOCAL: TOTAL DE LA FACTURA REFORZADO VISUALMENTE -->
                    <Border Background="#121214" CornerRadius="12" Padding="20" Margin="0,0,0,15" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL FACTURA" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="$579.50" Foreground="{StaticResource AccentEmerald}" FontSize="32" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- BOTÓN PRINCIPAL FOCAL -->
                    <Button Content="⚡ GENERAR FACTURA POS" Style="{StaticResource PrimaryActionButton}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</Page>
