                        <Label Text="Precio Unitario ($) *" FontSize="12" FontAttributes="Bold" TextColor="#94A3B8" />
                        <Entry x:Name="EditProductoPrecioEntry" Keyboard="Numeric" HeightRequest="44" TextColor="#F8FAFC" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Stock Disponible *" FontSize="12" FontAttributes="Bold" TextColor="#94A3B8" />
                        <Entry x:Name="EditProductoStockEntry" Keyboard="Numeric" HeightRequest="44" TextColor="#F8FAFC" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Código de Barras / SKU" FontSize="12" FontAttributes="Bold" TextColor="#94A3B8" />
                        <Entry x:Name="EditProductoCodigoBarraEntry" HeightRequest="44" TextColor="#F8FAFC" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="Cancelar" Clicked="OnCerrarModalEditProductoClicked" BackgroundColor="#0F172A" TextColor="#94A3B8" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                        <Button Grid.Column="1" Text="💾 Guardar Cambios" Clicked="OnGuardarEditProductoClicked" BackgroundColor="#F59E0B" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Modal Overlay Editar Cliente -->
        <Grid x:Name="ModalEditarClienteOverlay" Grid.Column="0" Grid.ColumnSpan="2" ZIndex="1010" IsVisible="False" BackgroundColor="#E0000000" HorizontalOptions="Fill" VerticalOptions="Fill">
            <Border HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="450" Margin="16" BackgroundColor="#1E293B" Stroke="#F59E0B" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="✏️ Editar Cliente Completo" FontSize="18" FontAttributes="Bold" TextColor="#F8FAFC" />
                    
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nombre / Razón Social *" FontSize="12" FontAttributes="Bold" TextColor="#94A3B8" />
                        <Entry x:Name="EditClienteNombreEntry" HeightRequest="44" TextColor="#F8FAFC" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="NIT / Documento Identidad *" FontSize="12" FontAttributes="Bold" TextColor="#94A3B8" />
                        <Entry x:Name="EditClienteDocumentoEntry" HeightRequest="44" TextColor="#F8FAFC" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Correo Electrónico *" FontSize="12" FontAttributes="Bold" TextColor="#94A3B8" />
                        <Entry x:Name="EditClienteEmailEntry" Keyboard="Email" HeightRequest="44" TextColor="#F8FAFC" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Teléfono" FontSize="12" FontAttributes="Bold" TextColor="#94A3B8" />
                        <Entry x:Name="EditClienteTelefonoEntry" Keyboard="Telephone" HeightRequest="44" TextColor="#F8FAFC" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Dirección" FontSize="12" FontAttributes="Bold" TextColor="#94A3B8" />
                        <Entry x:Name="EditClienteDireccionEntry" HeightRequest="44" TextColor="#F8FAFC" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="Cancelar" Clicked="OnCerrarModalEditClienteClicked" BackgroundColor="#0F172A" TextColor="#94A3B8" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                        <Button Grid.Column="1" Text="💾 Guardar Cambios" Clicked="OnGuardarEditClienteClicked" BackgroundColor="#F59E0B" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Modal Overlay Registrar Nuevo Cajero / Usuario -->
        <Grid x:Name="ModalUsuarioOverlay" Grid.Column="0" Grid.ColumnSpan="2" ZIndex="1010" IsVisible="False" BackgroundColor="#E0000000" HorizontalOptions="Fill" VerticalOptions="Fill">
            <Border HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="450" Margin="16" BackgroundColor="#1E293B" Stroke="#10B981" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="👤➕ Registrar Nuevo Cajero / Usuario" FontSize="18" FontAttributes="Bold" TextColor="#F8FAFC" />
                    
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nombre Completo *" FontSize="12" FontAttributes="Bold" TextColor="#94A3B8" />
                        <Entry x:Name="NuevoUsuarioNombreEntry" Placeholder="ej: Carlos Pérez" HeightRequest="44" TextColor="#F8FAFC" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nombre de Usuario (Username) *" FontSize="12" FontAttributes="Bold" TextColor="#94A3B8" />
                        <Entry x:Name="NuevoUsuarioUsernameEntry" Placeholder="ej: cajero2" HeightRequest="44" TextColor="#F8FAFC" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Contraseña *" FontSize="12" FontAttributes="Bold" TextColor="#94A3B8" />
                        <Entry x:Name="NuevoUsuarioPasswordEntry" Text="123" IsPassword="True" Placeholder="Contraseña" HeightRequest="44" TextColor="#F8FAFC" BackgroundColor="#0F172A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Rol / Nivel de Acceso *" FontSize="12" FontAttributes="Bold" TextColor="#94A3B8" />
                        <Picker x:Name="NuevoUsuarioRolPicker" SelectedIndex="0" HeightRequest="44" TextColor="#F8FAFC" BackgroundColor="#0F172A">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Cajero</x:String>
                                    <x:String>Admin</x:String>
                                    <x:String>Contador</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="Cancelar" Clicked="OnCerrarModalUsuarioClicked" BackgroundColor="#0F172A" TextColor="#94A3B8" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                        <Button Grid.Column="1" Text="💾 Guardar Cajero" Clicked="OnGuardarNuevoUsuarioClicked" BackgroundColor="#10B981" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Activity Indicator Loading Spinner -->
        <ActivityIndicator x:Name="LoadingSpinner" IsRunning="False" IsVisible="False" Color="#10B981" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="0" Grid.ColumnSpan="2" ZIndex="2000" />

    </Grid>
</ContentPage>
