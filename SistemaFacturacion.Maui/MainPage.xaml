<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SistemaFacturacion.Maui.MainPage"
             Title="Sistema de Facturación &amp; POS Empresarial (COP)"
             BackgroundColor="#E2E8F0">

    <!-- MASTER LAYOUT: BARRA LATERAL + CONTENIDO DUAL CAJERO / ADMIN -->
    <Grid ColumnDefinitions="Auto, *" RowDefinitions="*">

        <!-- 1. BARRA LATERAL NAVEGACIÓN (LEFT SIDEBAR) -->
        <Border Grid.Column="0" BackgroundColor="#0F172A" WidthRequest="64" Padding="6,14" StrokeThickness="0">
            <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                <!-- Logo Icon -->
                <Button Text="⚡" FontSize="18" BackgroundColor="#10B981" TextColor="White" HeightRequest="40" WidthRequest="40" CornerRadius="10" Padding="0" />
                
                <BoxView HeightRequest="1" Color="#1E293B" Margin="0,2" />
                
                <!-- Iconos de Navegación Vertical -->
                <Button Text="🛒" Clicked="OnRecargarClicked" BackgroundColor="#10B981" TextColor="White" HeightRequest="38" WidthRequest="38" CornerRadius="8" Padding="0" ToolTipProperties.Text="Punto de Venta POS" />
                <Button Text="📦" Clicked="OnAbrirModalBuscarProductoClicked" BackgroundColor="#1E293B" TextColor="#94A3B8" HeightRequest="38" WidthRequest="38" CornerRadius="8" Padding="0" ToolTipProperties.Text="Gestión de Inventario" />
                <Button Text="👥" Clicked="OnAbrirModalBuscarClienteClicked" BackgroundColor="#1E293B" TextColor="#94A3B8" HeightRequest="38" WidthRequest="38" CornerRadius="8" Padding="0" ToolTipProperties.Text="Directorio de Clientes" />
                <Button Text="📜" Clicked="OnAbrirModalCuentasClicked" BackgroundColor="#1E293B" TextColor="#94A3B8" HeightRequest="38" WidthRequest="38" CornerRadius="8" Padding="0" ToolTipProperties.Text="Historial de Facturación" />
                <Button Text="💵" Clicked="OnAbrirModalCajaClicked" BackgroundColor="#1E293B" TextColor="#94A3B8" HeightRequest="38" WidthRequest="38" CornerRadius="8" Padding="0" ToolTipProperties.Text="Control de Caja" />
                <Button x:Name="AdminPanelBtn" Text="🛡️" Clicked="OnAbrirModalAdminClicked" IsVisible="False" BackgroundColor="#1E293B" TextColor="#10B981" HeightRequest="38" WidthRequest="38" CornerRadius="8" Padding="0" ToolTipProperties.Text="Panel Admin" />

                <BoxView HeightRequest="1" Color="#1E293B" Margin="0,2" />

                <Button x:Name="ServerConfigBtn" Text="🌐" Clicked="OnAbrirModalServerClicked" BackgroundColor="#1E293B" TextColor="#38BDF8" HeightRequest="38" WidthRequest="38" CornerRadius="8" Padding="0" ToolTipProperties.Text="Config Servidor IP" />
                <Button x:Name="AbrirLoginBtn" Text="🔑" Clicked="OnAbrirModalLoginClicked" BackgroundColor="#10B981" TextColor="White" HeightRequest="38" WidthRequest="38" CornerRadius="8" Padding="0" ToolTipProperties.Text="Iniciar Sesión" />
                <Button x:Name="CerrarSesionBtn" Text="🚪" Clicked="OnCerrarSesionClicked" IsVisible="False" BackgroundColor="#EF4444" TextColor="White" HeightRequest="38" WidthRequest="38" CornerRadius="8" Padding="0" ToolTipProperties.Text="Cerrar Sesión" />
            </VerticalStackLayout>
        </Border>

        <!-- 2. CONTENIDO PRINCIPAL: BANNER SUPERIOR + DOS INTERFACES LADO A LADO -->
        <ScrollView x:Name="MainContentScrollView" Grid.Column="1" BackgroundColor="#CBD5E1" Padding="12">
            <VerticalStackLayout Spacing="12">

                <!-- BARRA DE PESTAÑAS / BOTONES DE CONMUTACIÓN DE INTERFAZ -->
                <Grid x:Name="TabHeaderGrid" ColumnDefinitions="*, *, *" ColumnSpacing="8">
                    <!-- Botón Interfaz del Cajero -->
                    <Button Grid.Column="0" x:Name="CajeroTabBtn" Text="🛒 Interfaz POS (Cajero)" Clicked="OnMostrarCajeroViewClicked" BackgroundColor="#15803D" TextColor="White" FontAttributes="Bold" FontSize="13" HeightRequest="44" CornerRadius="10" />

                    <!-- Botón Interfaz del Administrador -->
                    <Button Grid.Column="1" x:Name="AdminTabBtn" Text="📊 Dashboard (Administrador)" Clicked="OnMostrarAdminViewClicked" BackgroundColor="#1E40AF" TextColor="White" FontAttributes="Bold" FontSize="13" HeightRequest="44" CornerRadius="10" />

                    <!-- Botón Vista Dual (Ambas lado a lado) -->
                    <Button Grid.Column="2" x:Name="DualTabBtn" Text="🔳 Vista Dual" Clicked="OnMostrarVistaDualClicked" BackgroundColor="#475569" TextColor="White" FontAttributes="Bold" FontSize="13" HeightRequest="44" CornerRadius="10" />
                </Grid>

                <!-- GRID PRINCIPAL DE CONTENIDO -->
                <Grid x:Name="MainLayoutGrid" ColumnDefinitions="*, *" ColumnSpacing="12" RowDefinitions="Auto">

                    <!-- ========================================================================= -->
                    <!-- COLUMNA IZQUIERDA: INTERFAZ DEL CAJERO (DARK THEME POS TERMINAL)           -->
                    <!-- ========================================================================= -->
                    <Border x:Name="Quadrant1" Grid.Column="0" BackgroundColor="#111827" Stroke="#1F2937" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14">
                        <Grid RowDefinitions="Auto, *" RowSpacing="12">
                            
                            <!-- Header del POS -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                                <Button Grid.Column="0" Text="☰" BackgroundColor="Transparent" TextColor="#9CA3AF" FontSize="16" HeightRequest="32" Padding="0" />
                                <Label Grid.Column="1" Text="Punto de Venta POS" FontSize="18" FontAttributes="Bold" TextColor="#F9FAFB" VerticalOptions="Center" Margin="6,0,0,0" />
                                <Label x:Name="UserSessionLabel" Grid.Column="2" Text="🔒 Sesión Bloqueada" FontSize="11" FontAttributes="Bold" TextColor="#F87171" VerticalOptions="Center" />
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="1.2*, 1*" ColumnSpacing="14">
                                
                                <!-- Columna Izquierda: Filtros, Búsqueda, Clientes y Catálogo -->
                                <VerticalStackLayout Grid.Column="0" Spacing="12">
                                    
                                    <!-- CONTENEDOR 1: BÚSQUEDA Y SELECCIÓN DE CLIENTE/CATEGORÍA -->
                                    <Border BackgroundColor="#1F2937" Stroke="#374151" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                                        <VerticalStackLayout Spacing="10">
                                            <Label Text="🔎 Búsqueda &amp; Clientes" FontSize="13" FontAttributes="Bold" TextColor="#F9FAFB" />

                                            <!-- Buscador de Productos -->
                                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="#111827" Stroke="#374151" Padding="10,0" HeightRequest="44">
                                                <Grid ColumnDefinitions="Auto, *">
                                                    <Label Grid.Column="0" Text="🔍" TextColor="#9CA3AF" VerticalOptions="Center" FontSize="14" Margin="0,0,8,0"/>
                                                    <Entry Grid.Column="1" x:Name="BarcodeScannerEntry" Placeholder="Buscar por nombre o SKU..." Completed="OnBarcodeScannedCompleted" TextColor="#F9FAFB" PlaceholderColor="#9CA3AF" FontSize="12" BackgroundColor="Transparent" VerticalOptions="Center" HeightRequest="44" />
                                                </Grid>
                                            </Border>

                                            <!-- Selector Categoria -->
                                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="#111827" Stroke="#374151" Padding="10,0" HeightRequest="44">
                                                <Grid ColumnDefinitions="Auto, *">
                                                    <Label Grid.Column="0" Text="📊" TextColor="#9CA3AF" VerticalOptions="Center" FontSize="14" Margin="0,0,8,0"/>
                                                    <Picker Grid.Column="1" x:Name="ProductoPicker" ItemDisplayBinding="{Binding Nombre}" SelectedIndexChanged="OnProductoSelected" FontSize="12" TextColor="#F9FAFB" BackgroundColor="Transparent" VerticalOptions="Center" VerticalTextAlignment="Center" Margin="0" />
                                                </Grid>
                                            </Border>

                                            <!-- Selector de Cliente + Botón Registrar Cliente -->
                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                                <Border Grid.Column="0" StrokeShape="RoundRectangle 8" BackgroundColor="#111827" Stroke="#374151" Padding="10,0" HeightRequest="44">
                                                    <Grid ColumnDefinitions="Auto, *">
                                                        <Label Grid.Column="0" Text="👤" TextColor="#38BDF8" VerticalOptions="Center" FontSize="14" Margin="0,0,8,0"/>
                                                        <Picker Grid.Column="1" x:Name="ClientePicker" ItemDisplayBinding="{Binding Nombre}" SelectedIndexChanged="OnClienteSelected" FontSize="12" TextColor="#F9FAFB" BackgroundColor="Transparent" VerticalOptions="Center" VerticalTextAlignment="Center" Margin="0" />
                                                    </Grid>
                                                </Border>
                                                <Button Grid.Column="1" Text="👤➕ Cliente" Clicked="OnAbrirModalClienteClicked" BackgroundColor="#0284C7" TextColor="White" FontAttributes="Bold" FontSize="12" HeightRequest="44" CornerRadius="8" Padding="12,0" ToolTipProperties.Text="Registrar Nuevo Cliente" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- CONTENEDOR 2: CATÁLOGO DINÁMICO DE PRODUCTOS (BASE DE DATOS) -->
                                    <Border BackgroundColor="#1F2937" Stroke="#374151" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Grid.Column="0" Text="📦 Catálogo de Productos (Base de Datos)" FontSize="13" FontAttributes="Bold" TextColor="#F9FAFB" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="Tocar para agregar ➕" FontSize="10" TextColor="#10B981" VerticalOptions="Center" />
                                            </Grid>

                                            <CollectionView x:Name="ProductosCatalogCollectionView" HeightRequest="270" SelectionMode="None">
                                                <CollectionView.ItemsLayout>
                                                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                                                </CollectionView.ItemsLayout>
                                                <CollectionView.EmptyView>
                                                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center" Padding="20">
                                                        <Label Text="📦" FontSize="32" HorizontalOptions="Center"/>
                                                        <Label Text="No se encontraron productos en la base de datos." FontSize="12" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                                                    </VerticalStackLayout>
                                                </CollectionView.EmptyView>
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Stroke="#374151" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#111827" Padding="10" HeightRequest="110">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnProductoCardTapped" CommandParameter="{Binding .}" />
                                                            </Border.GestureRecognizers>
                                                            <Grid RowDefinitions="Auto, *, Auto, Auto" RowSpacing="2">
                                                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                                                    <Label Grid.Column="0" Text="{Binding Categoria}" FontSize="9" FontAttributes="Bold" TextColor="#38BDF8" LineBreakMode="TailTruncation" />
                                                                    <Border Grid.Column="1" BackgroundColor="#059669" StrokeThickness="0" StrokeShape="RoundRectangle 4" Padding="5,1">
                                                                        <Label Text="{Binding Stock, StringFormat='Stock: {0}'}" FontSize="8" FontAttributes="Bold" TextColor="White" />
                                                                    </Border>
                                                                </Grid>
                                                                <Label Grid.Row="1" Text="{Binding Nombre}" FontSize="12" FontAttributes="Bold" TextColor="#F9FAFB" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                                <Label Grid.Row="2" Text="{Binding CodigoBarra, StringFormat='SKU: {0}'}" FontSize="9" TextColor="#9CA3AF" LineBreakMode="TailTruncation" />
                                                                <Label Grid.Row="3" Text="{Binding PrecioCOPFormatted}" FontSize="13" FontAttributes="Bold" TextColor="#10B981" VerticalOptions="End" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- Badges Ocultos para compatibilidad -->
                                    <Border x:Name="ProductoCardBadge" IsVisible="False"><Label x:Name="ProductoBadgeNombre"/><Label x:Name="ProductoBadgePrecio"/><Label x:Name="ProductoBadgeCodigo"/><Border x:Name="StockBadgeBorder"><Label x:Name="ProductoBadgeStock"/></Border></Border>
                                    <Border x:Name="ClienteCardBadge" IsVisible="False"><Label x:Name="ClienteBadgeNombre"/><Label x:Name="ClienteBadgeDoc"/><Label x:Name="ClienteBadgeEmail"/><Label x:Name="ClienteBadgeTel"/></Border>

                                    <!-- CONTENEDOR 3: ACCIONES RÁPIDAS (CANTIDAD Y FORMA DE PAGO) -->
                                    <Border BackgroundColor="#1F2937" Stroke="#374151" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                                        <Grid ColumnDefinitions="70, Auto, *" ColumnSpacing="8">
                                            <Entry x:Name="CantidadEntry" Placeholder="Cant" Keyboard="Numeric" Text="1" HeightRequest="42" TextColor="#F9FAFC" PlaceholderColor="#6B7280" BackgroundColor="#111827" FontSize="12" HorizontalTextAlignment="Center" />
                                            <Button Grid.Column="1" Text="➕ Agregar" Clicked="OnAgregarProductoClicked" BackgroundColor="#10B981" TextColor="White" FontAttributes="Bold" FontSize="12" HeightRequest="42" CornerRadius="8" Padding="12,0" />
                                            <Border Grid.Column="2" StrokeShape="RoundRectangle 8" BackgroundColor="#111827" Stroke="#374151" Padding="8,0" HeightRequest="42">
                                                <Picker x:Name="FormaPagoPicker" FontSize="11" TextColor="#F9FAFC" BackgroundColor="Transparent" VerticalOptions="Center" VerticalTextAlignment="Center" Margin="0">
                                                    <Picker.ItemsSource>
                                                        <x:Array Type="{x:Type x:String}">
                                                            <x:String>Efectivo</x:String>
                                                            <x:String>Tarjeta de Crédito</x:String>
                                                            <x:String>Tarjeta de Débito</x:String>
                                                            <x:String>Transferencia</x:String>
                                                            <x:String>Crédito</x:String>
                                                        </x:Array>
                                                    </Picker.ItemsSource>
                                                </Picker>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Entry x:Name="DescuentoEntry" Placeholder="Desc %" Keyboard="Numeric" Text="0" Unfocused="OnDescuentoChanged" HeightRequest="28" FontSize="10" TextColor="#F9FAFC" PlaceholderColor="#6B7280" BackgroundColor="#1F2937" IsVisible="False" />
                                </VerticalStackLayout>

                                <!-- CONTENEDOR 4: RESUMEN DE VENTA, TOTALES Y BOTÓN COBRAR -->
                                <Border Grid.Column="1" BackgroundColor="#1F2937" Stroke="#374151" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14">
                                    <Grid RowDefinitions="Auto, *, Auto, Auto" RowSpacing="10">
                                        
                                        <Label Grid.Row="0" Text="🛒 Resumen de Venta" FontSize="14" FontAttributes="Bold" TextColor="#F9FAFC" />

                                        <!-- Lista de Ítems Comprados -->
                                        <CollectionView Grid.Row="1" x:Name="CarritoCollectionView" HeightRequest="220">
                                            <CollectionView.EmptyView>
                                                <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center" Padding="20">
                                                    <Label Text="🛒" FontSize="32" HorizontalOptions="Center"/>
                                                    <Label Text="Carrito de compras vacío" FontSize="11" TextColor="#6B7280" HorizontalOptions="Center" />
                                                </VerticalStackLayout>
                                            </CollectionView.EmptyView>
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*, Auto, Auto" Padding="6,6" ColumnSpacing="8">
                                                        <Label Grid.Column="0" Text="{Binding ProductoNombre}" FontSize="12" TextColor="#F9FAFC" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                                        <Label Grid.Column="1" Text="{Binding CantidadText}" FontSize="11" TextColor="#9CA3AF" Margin="4,0" VerticalOptions="Center" />
                                                        <Label Grid.Column="2" Text="{Binding SubtotalText}" FontSize="12" FontAttributes="Bold" TextColor="#10B981" VerticalOptions="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>

                                        <BoxView Grid.Row="2" HeightRequest="1" Color="#374151" Margin="0,4" />

                                        <!-- Totales & Botones de Acción POS -->
                                        <VerticalStackLayout Grid.Row="3" Spacing="10">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Grid.Column="0" Text="TOTAL:" FontSize="16" FontAttributes="Bold" TextColor="#F9FAFC" VerticalOptions="Center" />
                                                <Label Grid.Column="1" x:Name="TotalLabel" Text="$ 0 COP" FontSize="22" FontAttributes="Bold" TextColor="#10B981" HorizontalOptions="End" />
                                            </Grid>

                                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" IsVisible="False">
                                                <Label Grid.Row="0" Grid.Column="0" Text="Subtotal:" FontSize="10" TextColor="#9CA3AF" />
                                                <Label Grid.Row="0" Grid.Column="1" x:Name="SubtotalLabel" Text="$ 0 COP" FontSize="10" TextColor="#F9FAFC" />
                                                <Label Grid.Row="1" Grid.Column="0" Text="IVA (19%):" FontSize="10" TextColor="#9CA3AF" />
                                                <Label Grid.Row="1" Grid.Column="1" x:Name="ImpuestoLabel" Text="$ 0 COP" FontSize="10" TextColor="#9CA3AF" />
                                            </Grid>
                                            <Label x:Name="DescuentoLabel" Text="$ 0 COP" IsVisible="False" />

                                            <!-- BOTONES ACCIÓN: COBRAR (VERDE) Y CANCELAR VENTA (ROJO) -->
                                            <Grid ColumnDefinitions="1.2*, 1*" ColumnSpacing="8">
                                                <Button Grid.Column="0" x:Name="GenerarBtn" Text="Cobrar" Clicked="OnGenerarFacturaClicked" BackgroundColor="#10B981" TextColor="White" FontAttributes="Bold" FontSize="15" HeightRequest="48" CornerRadius="8" />
                                                <Button Grid.Column="1" Text="Cancelar Venta" Clicked="OnRecargarClicked" BackgroundColor="#EF4444" TextColor="White" FontAttributes="Bold" FontSize="11" HeightRequest="48" CornerRadius="8" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ========================================================================= -->
                    <!-- COLUMNA DERECHA: INTERFAZ DEL ADMINISTRADOR (LIGHT THEME DASHBOARD)         -->
                    <!-- ========================================================================= -->
                    <Border x:Name="Quadrant2" Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14">
                        <ScrollView VerticalScrollBarVisibility="Never">
                            <VerticalStackLayout Spacing="10">

                                <!-- TOP KPIS: 3 TARJETAS SUPERIORES -->
                                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                                    <!-- KPI 1: Ventas de Hoy -->
                                    <Border Grid.Column="0" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Grid.Column="0" Text="🟢 Ventas de Hoy" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                                                <Label x:Name="KpiVentasHoyTrendLabel" Grid.Column="1" Text="0 hoy" FontSize="9" FontAttributes="Bold" TextColor="#16A34A" />
                                            </Grid>
                                            <Label x:Name="KpiVentasHoyLabel" Text="$ 0 COP" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- KPI 2: Pedidos -->
                                    <Border Grid.Column="1" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Grid.Column="0" Text="💡 Total Ventas" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                                                <Label x:Name="KpiPedidosTrendLabel" Grid.Column="1" Text="0 facturas" FontSize="9" FontAttributes="Bold" TextColor="#16A34A" />
                                            </Grid>
                                            <Label x:Name="KpiPedidosLabel" Text="0" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- KPI 3: Poco Stock -->
                                    <Border Grid.Column="2" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Grid.Column="0" Text="📝 Poco Stock" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
                                                <Label x:Name="KpiPocoStockSubLabel" Grid.Column="1" Text="0 prods" FontSize="9" FontAttributes="Bold" TextColor="#DC2626" />
                                            </Grid>
                                            <Label x:Name="KpiPocoStockLabel" Text="0" FontSize="18" FontAttributes="Bold" TextColor="#DC2626" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <!-- GRÁFICOS VISUALES: RESUMEN DE VENTAS Y ESTADO DEL INVENTARIO -->
                                <Grid ColumnDefinitions="2*, *" ColumnSpacing="8">
                                    <!-- Resumen de Ventas Bar Chart UI -->
                                    <Border Grid.Column="0" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" HeightRequest="120">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="Resumen de Ventas Recientes" FontSize="11" FontAttributes="Bold" TextColor="#0F172A" />
                                            <!-- Representación de Barras de Ventas Dinámicas -->
                                            <Grid ColumnDefinitions="*, *, *, *, *, *, *, *, *, *" ColumnSpacing="3" VerticalOptions="End" HeightRequest="80" Padding="0,10,0,0">
                                                <BoxView x:Name="BarVenta0" Grid.Column="0" Color="#3B82F6" HeightRequest="10" VerticalOptions="End" CornerRadius="2" />
                                                <BoxView x:Name="BarVenta1" Grid.Column="1" Color="#3B82F6" HeightRequest="10" VerticalOptions="End" CornerRadius="2" />
                                                <BoxView x:Name="BarVenta2" Grid.Column="2" Color="#3B82F6" HeightRequest="10" VerticalOptions="End" CornerRadius="2" />
                                                <BoxView x:Name="BarVenta3" Grid.Column="3" Color="#3B82F6" HeightRequest="10" VerticalOptions="End" CornerRadius="2" />
                                                <BoxView x:Name="BarVenta4" Grid.Column="4" Color="#3B82F6" HeightRequest="10" VerticalOptions="End" CornerRadius="2" />
                                                <BoxView x:Name="BarVenta5" Grid.Column="5" Color="#60A5FA" HeightRequest="10" VerticalOptions="End" CornerRadius="2" />
                                                <BoxView x:Name="BarVenta6" Grid.Column="6" Color="#3B82F6" HeightRequest="10" VerticalOptions="End" CornerRadius="2" />
                                                <BoxView x:Name="BarVenta7" Grid.Column="7" Color="#3B82F6" HeightRequest="10" VerticalOptions="End" CornerRadius="2" />
                                                <BoxView x:Name="BarVenta8" Grid.Column="8" Color="#3B82F6" HeightRequest="10" VerticalOptions="End" CornerRadius="2" />
                                                <BoxView x:Name="BarVenta9" Grid.Column="9" Color="#2563EB" HeightRequest="10" VerticalOptions="End" CornerRadius="2" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- Estado de Inventario Donut Chart UI -->
                                    <Border Grid.Column="1" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" HeightRequest="120">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="Salud Inventario" FontSize="11" FontAttributes="Bold" TextColor="#0F172A" />
                                            <!-- Diagrama Donut de Estado -->
                                            <Grid HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="75" WidthRequest="75" Margin="0,4">
                                                <Ellipse x:Name="EstadoInventarioEllipse" WidthRequest="70" HeightRequest="70" Stroke="#10B981" StrokeThickness="8" HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Label x:Name="EstadoInventarioLabel" Text="100%" FontSize="10" FontAttributes="Bold" TextColor="#0F172A" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <!-- SECCIÓN 1: HISTORIAL GENERAL DE VENTAS / FACTURAS (CON OPCIÓN DE ANULAR) -->
                                <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Grid.Column="0" Text="📜 Historial Completo de Ventas" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                                            <Button Text="🔄 Refrescar" Clicked="OnRecargarClicked" BackgroundColor="#3B82F6" TextColor="White" FontSize="10" HeightRequest="26" CornerRadius="4" Padding="6,0"/>
                                        </Grid>

                                        <!-- BARRA DE BÚSQUEDA Y FILTRO POR FECHA -->
                                        <Grid ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="6" Margin="0,2,0,4">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                                <CheckBox x:Name="AdminFiltrarPorFechaCheckBox" CheckedChanged="OnAdminFiltrarPorFechaCheckedChanged" VerticalOptions="Center" ToolTipProperties.Text="Activar/Desactivar filtro por fecha" />
                                                <Label Text="📅 Filtrar Fecha:" FontSize="11" FontAttributes="Bold" TextColor="#64748B" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <DatePicker x:Name="AdminFechaFiltroDatePicker" Grid.Column="1" DateSelected="OnAdminFechaFiltroChanged" Format="dd/MM/yyyy" FontSize="11" TextColor="#0F172A" HeightRequest="34" WidthRequest="115" VerticalOptions="Center" IsEnabled="{Binding Source={x:Reference AdminFiltrarPorFechaCheckBox}, Path=IsChecked}" />
