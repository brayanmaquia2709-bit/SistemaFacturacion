@page "/facturas"
@rendermode InteractiveServer
@using SistemaFacturacion.Core.Entities

@using SistemaFacturacion.Blazor.Services
@inject FacturacionApiService ApiService
@inject NavigationManager NavManager

<PageTitle>Facturas Emitidas</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-receipt text-indigo me-2"></i>Facturas Emitidas</h2>
        <p class="text-muted mb-0">Consulta, visualiza y envía por correo las facturas del sistema</p>
    </div>
    <div>
        <a href="nueva-factura" class="btn btn-indigo me-2 fw-bold shadow-sm">
            ⚡ Nueva Factura (POS)
        </a>
        <a href="http://localhost:5145/api/Exportar/ventas-excel" target="_blank" class="btn btn-outline-success me-2">
            <i class="bi bi-file-earmark-excel me-1"></i> Exportar Excel
        </a>
        <button class="btn btn-outline-primary" @onclick="CargarFacturas">
            <i class="bi bi-arrow-clockwise me-1"></i> Actualizar
        </button>
    </div>

</div>

@if (mensaje != null)
{
    <div class="alert alert-@tipoAlerta alert-dismissible fade show" role="alert">
        @mensaje
        <button type="button" class="btn-close" @onclick="() => mensaje = null"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-center">
            <div class="col-md-6 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="Buscar por número o cliente..." @bind="busqueda" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-md-6 col-lg-8 text-md-end text-muted small">
                Total de facturas: <strong>@FacturasFiltradas.Count()</strong>
            </div>
        </div>
    </div>
</div>

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Cargando facturas...</p>
    </div>
}
else if (!FacturasFiltradas.Any())
{
    <div class="card shadow-sm text-center py-5">
        <div class="card-body">
            <i class="bi bi-receipt-cutoff display-1 text-muted"></i>
            <h4 class="mt-3">No se encontraron facturas</h4>
            <p class="text-muted">No hay facturas registradas que coincidan con la búsqueda.</p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>N° Factura</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-end">Impuestos</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in FacturasFiltradas)
                    {
                        <tr>
                            <td>
                                <span class="fw-bold text-indigo">@f.NumeroFactura</span>
                            </td>
                            <td>@f.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="fw-semibold">@f.Cliente?.Nombre</div>
                                <div class="small text-muted">@f.Cliente?.Email</div>
                            </td>
                            <td class="text-end">$@f.Subtotal.ToString("N2")</td>
                            <td class="text-end text-muted">$@f.ImpuestosTotal.ToString("N2")</td>
                            <td class="text-end fw-bold text-success">$@f.Total.ToString("N2")</td>
                            <td class="text-center">
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 rounded-pill">
                                    @f.Estado
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" @onclick="() => AbrirDetalle(f)" title="Ver Detalle">
                                        👁️ Detalle
                                    </button>
                                    <a href="http://localhost:5145/api/Facturas/@f.Id/pdf" target="_blank" class="btn btn-outline-danger" title="Descargar PDF">
                                        📥 PDF
                                    </a>
                                    <button class="btn btn-outline-primary" @onclick="() => AbrirModalCorreo(f)" title="Enviar Correo">
                                        ✉️ Email
                                    </button>
                                    <a href="https://wa.me/?text=Hola%2C%20adjunto%20factura%20%23@f.NumeroFactura%20por%20$@f.Total.ToString("N2").%20Ver%20PDF%3A%20http%3A%2F%2Flocalhost%3A5145%2Fapi%2FFacturas%2F@f.Id%2Fpdf" target="_blank" class="btn btn-outline-success" title="Compartir WhatsApp">
                                        📲 WA
                                    </a>
                                    @if (f.Estado != "Anulada")
                                    {
                                        <button class="btn btn-outline-dark" @onclick="() => AnularFactura(f.Id)" title="Emitir Nota de Crédito / Anular">
                                            🚫 Anular
                                        </button>
                                    }
                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* Modal Detalle Factura *@
@if (facturaSeleccionada != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold">
                        📄 Detalle de Factura: @facturaSeleccionada.NumeroFactura
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarDetalle"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="fw-bold text-muted mb-1">DATOS DEL CLIENTE</h6>
                            <p class="mb-0 fw-semibold">@facturaSeleccionada.Cliente?.Nombre</p>
                            <p class="mb-0 text-muted">Email: @facturaSeleccionada.Cliente?.Email</p>
                            <p class="mb-0 text-muted">Teléfono: @facturaSeleccionada.Cliente?.Telefono</p>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <h6 class="fw-bold text-muted mb-1">FECHA Y HORA</h6>
                            <p class="mb-0">@facturaSeleccionada.Fecha.ToString("f")</p>
                            <span class="badge bg-success mt-1">@facturaSeleccionada.Estado</span>
                        </div>
                    </div>

                    <h6 class="fw-bold text-muted mb-2">PRODUCTOS / SERVICIOS</h6>
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-center">Cantidad</th>
                                    <th class="text-end">Precio Unit.</th>
                                    <th class="text-end">Subtotal</th>
                                    <th class="text-end">IVA</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var det in facturaSeleccionada.Detalles)
                                {
                                    <tr>
                                        <td>@det.Producto?.Nombre</td>
                                        <td class="text-center">@det.Cantidad</td>
                                        <td class="text-end">$@det.PrecioUnitario.ToString("N2")</td>
                                        <td class="text-end">$@det.Subtotal.ToString("N2")</td>
                                        <td class="text-end text-muted">$@det.ImpuestoMonto.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="row justify-content-end">
                        <div class="col-md-5">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between bg-transparent">
                                    <span>Subtotal:</span>
                                    <strong>$@facturaSeleccionada.Subtotal.ToString("N2")</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between bg-transparent text-muted">
                                    <span>Impuestos (19%):</span>
                                    <span>$@facturaSeleccionada.ImpuestosTotal.ToString("N2")</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between bg-light fw-bold text-success fs-5">
                                    <span>Total Final:</span>
                                    <span>$@facturaSeleccionada.Total.ToString("N2")</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <a href="http://localhost:5145/api/Facturas/@facturaSeleccionada.Id/pdf" target="_blank" class="btn btn-danger">
                        📥 Descargar PDF
                    </a>
                    <button type="button" class="btn btn-secondary" @onclick="CerrarDetalle">Cerrar</button>
                </div>

            </div>
        </div>
    </div>
}

@* Modal Enviar Correo *@
@if (facturaParaCorreo != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">✉️ Enviar Factura por Correo</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalCorreo"></button>
                </div>
                <div class="modal-body">
                    <p>Se enviará un archivo PDF adjunto con la factura <strong>@facturaParaCorreo.NumeroFactura</strong>.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Correo Electrónico Destino</label>
                        <input type="email" class="form-control" @bind="correoDestino" placeholder="ejemplo@correo.com" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalCorreo" disabled="@enviandoCorreo">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="EnviarCorreo" disabled="@enviandoCorreo">
                        @if (enviandoCorreo)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Enviando...</span>
                        }
                        else
                        {
                            <span>✉️ Enviar Factura</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Factura> facturas = new();
    private bool cargando = true;
    private string busqueda = "";
    private string? mensaje;
    private string tipoAlerta = "info";

    private Factura? facturaSeleccionada;
    private Factura? facturaParaCorreo;
    private string correoDestino = "";
    private bool enviandoCorreo = false;

    private IEnumerable<Factura> FacturasFiltradas =>
        string.IsNullOrWhiteSpace(busqueda)
            ? facturas
            : facturas.Where(f => (f.NumeroFactura?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                  (f.Cliente?.Nombre?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await CargarFacturas();
    }

    private async Task CargarFacturas()
    {
        cargando = true;
        try
        {
            facturas = await ApiService.GetFacturasAsync();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar las facturas: {ex.Message}";
            tipoAlerta = "danger";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirDetalle(Factura f)
    {
        facturaSeleccionada = f;
    }

    private void CerrarDetalle()
    {
        facturaSeleccionada = null;
    }

    private void AbrirModalCorreo(Factura f)
    {
        facturaParaCorreo = f;
        correoDestino = f.Cliente?.Email ?? "";
    }

    private void CerrarModalCorreo()
    {
        facturaParaCorreo = null;
        correoDestino = "";
    }

    private async Task EnviarCorreo()
    {
        if (facturaParaCorreo == null || string.IsNullOrWhiteSpace(correoDestino)) return;

        enviandoCorreo = true;
        try
        {
            bool ok = await ApiService.EnviarCorreoAsync(facturaParaCorreo.Id, correoDestino);
            if (ok)
            {
                mensaje = $"Factura #{facturaParaCorreo.NumeroFactura} enviada exitosamente a {correoDestino}";
                tipoAlerta = "success";
                CerrarModalCorreo();
            }
            else
            {
                mensaje = "Ocurrió un error al intentar enviar la factura por correo.";
                tipoAlerta = "warning";
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error de envío: {ex.Message}";
            tipoAlerta = "danger";
        }
        finally
        {
            enviandoCorreo = false;
        }
    }

    private async Task AnularFactura(int facturaId)
    {
        bool ok = await ApiService.AnularFacturaAsync(facturaId, "Anulada por usuario admin");
        if (ok)
        {
            mensaje = $"Factura #{facturaId} anulada correctamente. Se ha emitido la Nota de Crédito y devuelto el inventario.";
            tipoAlerta = "success";
            await CargarFacturas();
        }
        else
        {
            mensaje = "Error al intentar anular la factura.";
            tipoAlerta = "danger";
        }
    }
}

