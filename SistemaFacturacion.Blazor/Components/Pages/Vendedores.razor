@page "/vendedores"
@rendermode InteractiveServer
@using SistemaFacturacion.Core.Entities
@using SistemaFacturacion.Blazor.Services
@inject FacturacionApiService ApiService

<PageTitle>Vendedores | Facturación Electrónica</PageTitle>

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">👔 Gestión de Vendedores / Usuarios</h2>
            <p class="text-muted mb-0">Administra los accesos de cajeros y personal de facturación del sistema.</p>
        </div>
        <button class="btn btn-indigo px-4 fw-bold" @onclick="AbrirModalNuevo">
            ➕ Nuevo Vendedor
        </button>
    </div>

    @if (mensaje != null)
    {
        <div class="alert alert-@tipoAlerta alert-dismissible fade show shadow-sm mb-4" role="alert">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = null"></button>
        </div>
    }

    @if (cargando)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-indigo" role="status"></div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th># ID</th>
                            <th>Nombre Completo</th>
                            <th>Nombre de Usuario (Login)</th>
                            <th class="text-center">Rol</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in usuarios)
                        {
                            <tr>
                                <td>@u.Id</td>
                                <td class="fw-bold text-dark">👤 @u.Nombre</td>
                                <td><code class="text-indigo bg-light px-2 py-1 rounded">@u.Username</code></td>
                                <td class="text-center">
                                    <span class="badge @(u.Rol == "Admin" ? "bg-purple text-white" : u.Rol == "Cajero" ? "bg-primary" : "bg-info text-dark") fs-6">
                                        @u.Rol
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @(u.Activo ? "bg-success bg-opacity-10 text-success border border-success" : "bg-danger") px-3 py-1 rounded-pill">
                                        @(u.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarUsuario(u)" title="Eliminar Vendedor">
                                        🗑️ Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@* Modal Flotante Registrar Vendedor *@
@if (mostrarModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.6); z-index: 1050;" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
                <div class="modal-header bg-indigo text-white">
                    <h5 class="modal-title fw-bold">➕ Registrar Nuevo Vendedor</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body p-4 bg-white text-dark">
                    <EditForm Model="usuarioForm" OnValidSubmit="GuardarUsuario">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Nombre Completo *</label>
                            <InputText class="form-control text-dark bg-light border" @bind-Value="usuarioForm.Nombre" placeholder="Ej: Carlos Ramírez" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Nombre de Usuario (Login) *</label>
                            <InputText class="form-control text-dark bg-light border" @bind-Value="usuarioForm.Username" placeholder="Ej: cajero3" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Contraseña *</label>
                            <InputText class="form-control text-dark bg-light border" type="password" @bind-Value="usuarioForm.PasswordHash" placeholder="Contraseña de acceso" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Rol / Permisos *</label>
                            <InputSelect class="form-select text-dark bg-light border" @bind-Value="usuarioForm.Rol">
                                <option value="Cajero">Cajero (Facturación POS)</option>
                                <option value="Admin">Administrador (Acceso Total)</option>
                                <option value="Contador">Contador (Reportes)</option>
                            </InputSelect>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3">
                            <button type="button" class="btn btn-secondary px-4 fw-bold" @onclick="CerrarModal">Cancelar</button>
                            <button type="submit" class="btn btn-indigo px-4 fw-bold">💾 Guardar Vendedor</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool cargando = true;
    private List<Usuario> usuarios = new();
    private bool mostrarModal = false;
    private Usuario usuarioForm = new();
    private string? mensaje;
    private string tipoAlerta = "info";

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuariosAsync();
    }

    private async Task CargarUsuariosAsync()
    {
        cargando = true;
        try
        {
            usuarios = await ApiService.GetUsuariosAsync();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar vendedores: {ex.Message}";
            tipoAlerta = "danger";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalNuevo()
    {
        usuarioForm = new Usuario
        {
            Rol = "Cajero",
            Activo = true,
            PasswordHash = "123456"
        };
        mostrarModal = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task GuardarUsuario()
    {
        if (string.IsNullOrWhiteSpace(usuarioForm.Nombre) || string.IsNullOrWhiteSpace(usuarioForm.Username))
        {
            mensaje = "Por favor ingrese nombre y nombre de usuario.";
            tipoAlerta = "warning";
            return;
        }

        var creado = await ApiService.CrearUsuarioAsync(usuarioForm);
        if (creado != null)
        {
            mostrarModal = false;
            mensaje = $"Vendedor '{creado.Nombre}' registrado exitosamente con usuario '{creado.Username}'.";
            tipoAlerta = "success";
            await CargarUsuariosAsync();
        }
        else
        {
            mensaje = "No se pudo registrar el vendedor. El usuario podría estar duplicado.";
            tipoAlerta = "danger";
        }
    }

    private async Task EliminarUsuario(Usuario u)
    {
        bool ok = await ApiService.EliminarUsuarioAsync(u.Id);
        if (ok)
        {
            mensaje = $"Vendedor '{u.Nombre}' eliminado correctamente.";
            tipoAlerta = "success";
            await CargarUsuariosAsync();
        }
        else
        {
            mensaje = "No se pudo eliminar el vendedor.";
            tipoAlerta = "danger";
        }
    }
}
