@page "/caja"
@rendermode InteractiveServer
@using SistemaFacturacion.Core.DTOs
@using SistemaFacturacion.Core.Entities
@using SistemaFacturacion.Blazor.Services
@inject FacturacionApiService ApiService

<PageTitle>Control y Arqueo de Caja - POS</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">💵 Control y Arqueo de Turnos de Caja (X / Z)</h2>
            <p class="text-muted small mb-0">Monitoree la apertura, movimientos, ventas en efectivo y arqueos de caja en tiempo real.</p>
        </div>
    </div>

    @if (cajaActiva != null)
    {
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 bg-primary text-white">
                    <div class="card-body p-4">
                        <span class="badge bg-white text-primary fw-bold mb-2">TURNO ACTIVO</span>
                        <h4 class="fw-bold">@cajaActiva.UsuarioNombre</h4>
                        <p class="mb-1 text-white-50">Abierto: @cajaActiva.FechaApertura.ToString("dd/MM/yyyy HH:mm")</p>
                        <hr class="border-white opacity-25" />
                        <div class="d-flex justify-content-between">
                            <span>Fondo Inicial:</span>
                            <strong class="fs-5">$@cajaActiva.MontoInicial.ToString("N2")</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 bg-success text-white">
                    <div class="card-body p-4">
                        <span class="badge bg-white text-success fw-bold mb-2">FLUJO EN EFECTIVO</span>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span>Ventas Efectivo:</span>
                            <strong>$@cajaActiva.TotalVentasEfectivo.ToString("N2")</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span>Abonos Recibidos:</span>
                            <strong>$@cajaActiva.TotalAbonos.ToString("N2")</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span>Movimientos (Neto):</span>
                            <strong>$@((cajaActiva.TotalIngresos - cajaActiva.TotalEgresos).ToString("N2"))</strong>
                        </div>
                        <hr class="border-white opacity-25" />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold fs-6">EFECTIVO ESPERADO:</span>
                            <strong class="fs-4">$@((cajaActiva.MontoInicial + cajaActiva.TotalVentasEfectivo + cajaActiva.TotalAbonos + cajaActiva.TotalIngresos - cajaActiva.TotalEgresos).ToString("N2"))</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">🔒 Realizar Arqueo Z / Cierre</h5>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Efectivo Real Contado en Caja ($)</label>
                            <input type="number" step="0.01" class="form-control form-control-lg" @bind="efectivoRealContado" placeholder="Ingrese dinero contado" />
                        </div>
                        <button class="btn btn-danger w-100 py-2 fw-bold" @onclick="CerrarTurnoCaja">
                            🔒 Cerrar Caja y Generar Reporte Z
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 p-4 text-center bg-light">
            <h4 class="fw-bold text-dark">No hay un turno de caja abierto en este momento</h4>
            <p class="text-muted">Abra un nuevo turno ingresando el dinero de base inicial:</p>
            <div class="row justify-content-center">
                <div class="col-md-4">
                    <div class="input-group mb-3">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control" @bind="montoInicialApertura" placeholder="Monto Inicial" />
                        <button class="btn btn-success fw-bold" @onclick="AbrirTurnoCaja">🔓 Abrir Turno</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold mb-0">📜 Historial de Turnos y Cierres de Caja</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th># Turno</th>
                        <th>Cajero</th>
                        <th>Apertura</th>
                        <th>Cierre</th>
                        <th>Fondo Inicial</th>
                        <th>Ventas Efectivo</th>
                        <th>Esperado</th>
                        <th>Real Contado</th>
                        <th>Diferencia</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in historialCajas)
                    {
                        <tr>
                            <td><strong class="text-primary">#@c.Id</strong></td>
                            <td>@c.UsuarioNombre</td>
                            <td>@c.FechaApertura.ToString("dd/MM/yy HH:mm")</td>
                            <td>@(c.FechaCierre.HasValue ? c.FechaCierre.Value.ToString("dd/MM/yy HH:mm") : "-")</td>
                            <td>$@c.MontoInicial.ToString("N2")</td>
                            <td>$@c.TotalVentasEfectivo.ToString("N2")</td>
                            <td>$@c.EfectivoEsperado.ToString("N2")</td>
                            <td>$@c.EfectivoReal.ToString("N2")</td>
                            <td>
                                @if (c.Estado == "Cerrada")
                                {
                                    @if (c.Diferencia == 0)
                                    {
                                        <span class="badge bg-success">Exacto ($0.00)</span>
                                    }
                                    else if (c.Diferencia > 0)
                                    {
                                        <span class="badge bg-info text-dark">+$@c.Diferencia.ToString("N2") (Sobrante)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">-$@Math.Abs(c.Diferencia).ToString("N2") (Faltante)</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(c.Estado == "Abierta" ? "bg-warning text-dark" : "bg-secondary")">@c.Estado</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private CajaSesion? cajaActiva;
    private List<CajaSesion> historialCajas = new();
    private decimal montoInicialApertura = 100000;
    private decimal efectivoRealContado = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarCajaAsync();
    }

    private async Task CargarCajaAsync()
    {
        cajaActiva = await ApiService.GetCajaActivaAsync(1);
        if (cajaActiva != null)
        {
            efectivoRealContado = cajaActiva.MontoInicial + cajaActiva.TotalVentasEfectivo + cajaActiva.TotalAbonos + cajaActiva.TotalIngresos - cajaActiva.TotalEgresos;
        }

        historialCajas = await ApiService.GetHistorialCajasAsync();
    }

    private async Task AbrirTurnoCaja()
    {
        var dto = new AperturaCajaDto
        {
            UsuarioId = 1,
            UsuarioNombre = "Admin Web",
            MontoInicial = montoInicialApertura
        };

        await ApiService.AbrirCajaAsync(dto);
        await CargarCajaAsync();
    }

    private async Task CerrarTurnoCaja()
    {
        if (cajaActiva == null) return;

        var dto = new CierreCajaDto
        {
            CajaSesionId = cajaActiva.Id,
            EfectivoReal = efectivoRealContado,
            NotasCierre = "Cierre Z desde Web Admin"
        };

        await ApiService.CerrarCajaAsync(dto);
        await CargarCajaAsync();
    }
}
