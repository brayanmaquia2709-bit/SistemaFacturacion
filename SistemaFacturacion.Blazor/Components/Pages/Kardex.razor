@page "/kardex"
@rendermode InteractiveServer
@using SistemaFacturacion.Core.Entities

@using SistemaFacturacion.Blazor.Services
@inject FacturacionApiService ApiService

<PageTitle>Kardex de Inventario</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-box-seam text-success me-2"></i>Kardex e Historial de Inventarios</h2>
        <p class="text-muted mb-0">Auditoría completa de movimientos de entrada, salida y ajustes de stock</p>
    </div>
    <button class="btn btn-success" @onclick="() => mostrarModalAjuste = true">
        <i class="bi bi-plus-slash-minus me-1"></i> Ajustar Stock
    </button>
</div>

@if (mensaje != null)
{
    <div class="alert alert-@tipoAlerta alert-dismissible fade show" role="alert">
        @mensaje
        <button type="button" class="btn-close" @onclick="() => mensaje = null"></button>
    </div>
}

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-success" role="status"></div>
        <p class="mt-2 text-muted">Cargando movimientos de inventario...</p>
    </div>
}
else if (!movimientos.Any())
{
    <div class="card shadow-sm text-center py-5">
        <div class="card-body">
            <i class="bi bi-journal-text display-1 text-muted"></i>
            <h4 class="mt-3">No hay movimientos registrados</h4>
            <p class="text-muted">Los movimientos se registrarán automáticamente al vender o ajustar productos.</p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha y Hora</th>
                        <th>Producto</th>
                        <th class="text-center">Tipo Movimiento</th>
                        <th class="text-center">Stock Anterior</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-center">Nuevo Stock</th>
                        <th>Motivo / Referencia</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in movimientos)
                    {
                        <tr>
                            <td>@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-semibold">@m.Producto?.Nombre</td>
                            <td class="text-center">
                                @if (m.TipoMovimiento == "Entrada")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">📥 Entrada</span>
                                }
                                else if (m.TipoMovimiento == "Salida")
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1">📤 Salida</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1">⚙️ Ajuste</span>
                                }
                            </td>
                            <td class="text-center text-muted">@m.StockAnterior</td>
                            <td class="text-center fw-bold">@m.Cantidad</td>
                            <td class="text-center fw-bold text-success">@m.StockNuevo</td>
                            <td>@m.Motivo</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* Modal Ajuste Stock *@
@if (mostrarModalAjuste)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">⚙️ Realizar Ajuste de Stock</h5>
                    <button type="button" class="btn-close" @onclick="() => mostrarModalAjuste = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Producto</label>
                        <select class="form-select" @bind="productoIdAjuste">
                            <option value="0">-- Seleccione Producto --</option>
                            @foreach (var p in productos)
                            {
                                <option value="@p.Id">@p.Nombre (Stock Actual: @p.Stock)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tipo de Movimiento</label>
                        <select class="form-select" @bind="tipoAjuste">
                            <option value="Entrada">📥 Entrada (Compra o Reabastecimiento)</option>
                            <option value="Salida">📤 Salida (Retiro o Merma)</option>
                            <option value="Ajuste">⚙️ Ajuste Directo de Inventario</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Cantidad</label>
                        <input type="number" class="form-control" @bind="cantidadAjuste" min="1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Motivo del Ajuste</label>
                        <input type="text" class="form-control" @bind="motivoAjuste" placeholder="Ej: Compra a proveedor, daño, conteo físico" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => mostrarModalAjuste = false">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="GuardarAjuste">💾 Guardar Ajuste</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MovimientoInventario> movimientos = new();
    private List<Producto> productos = new();
    private bool cargando = true;
    private bool mostrarModalAjuste = false;
    private string? mensaje;
    private string tipoAlerta = "info";

    private int productoIdAjuste = 0;
    private string tipoAjuste = "Entrada";
    private int cantidadAjuste = 1;
    private string motivoAjuste = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarKardex();
    }

    private async Task CargarKardex()
    {
        cargando = true;
        try
        {
            movimientos = await ApiService.GetMovimientosKardexAsync();
            productos = await ApiService.GetProductosAsync();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar Kardex: {ex.Message}";
            tipoAlerta = "danger";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarAjuste()
    {
        if (productoIdAjuste <= 0 || cantidadAjuste <= 0 || string.IsNullOrWhiteSpace(motivoAjuste))
        {
            mensaje = "Complete todos los campos del ajuste.";
            tipoAlerta = "warning";
            return;
        }

        bool ok = await ApiService.RegistrarAjusteStockAsync(productoIdAjuste, cantidadAjuste, tipoAjuste, motivoAjuste);
        if (ok)
        {
            mensaje = "Ajuste de inventario registrado correctamente.";
            tipoAlerta = "success";
            mostrarModalAjuste = false;
            await CargarKardex();
        }
        else
        {
            mensaje = "Error al procesar el ajuste de inventario.";
            tipoAlerta = "danger";
        }
    }
}
