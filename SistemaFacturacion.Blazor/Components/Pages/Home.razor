@code {
    private string activeTab = "cajero"; // Default "cajero"
    private string adminTab = "facturas"; // "facturas", "productos", "clientes", "usuarios"

    private List<Producto> productos = new();
    private List<Cliente> clientes = new();
    private List<Factura> facturas = new();
    private List<Usuario> usuarios = new();

    private List<CarritoItemModel> carrito = new();
    private int cantidadSeleccionada = 1;
    private string formaPagoSeleccionada = "Efectivo";
    private int clienteSeleccionadoId = 0;
    private string busquedaFiltro = "";
    private string categoriaFiltro = "";

    private decimal ventasHoyCOP = 0;
    private int ventasHoyCount = 0;
    private int totalFacturasCount = 0;
    private int pocoStockCount = 0;
    private int saludInventarioPct = 100;
    private DateTime? filtroFechaFactura;

    private Usuario? usuarioLogueado;
    private bool esAdmin => usuarioLogueado != null &&
        (usuarioLogueado.Rol.Equals("Admin", StringComparison.OrdinalIgnoreCase) ||
         usuarioLogueado.Rol.Equals("Administrador", StringComparison.OrdinalIgnoreCase));

    private bool mostrarModalLogin = false;
    private string loginUsuario = "";
    private string loginPassword = "";
    private bool loginRecordar = false;
    private string loginError = "";

    private bool mostrarModalProducto = false;
    private Producto productoEdicion = new();

    private bool mostrarModalCliente = false;
    private Cliente clienteEdicion = new();

    private bool mostrarModalCajero = false;
    private Usuario cajeroNuevo = new();
    private string cajeroNuevoPassword = "";

    private bool mostrarModalFacturaDoc = false;
    private Factura? facturaReciente;
    private bool procesandoVenta = false;

    public class CarritoItemModel
    {
        public int ProductoId { get; set; }
        public string ProductoNombre { get; set; } = "";
        public int Cantidad { get; set; }
        public decimal PrecioUnitario { get; set; }
        public decimal Subtotal => Cantidad * PrecioUnitario;
    }

    private CancellationTokenSource? _autoRefreshCts;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
        IniciarAutoRefresco();
    }

    private void IniciarAutoRefresco()
    {
        _autoRefreshCts = new CancellationTokenSource();
        var token = _autoRefreshCts.Token;
        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(3000, token);
                    if (!token.IsCancellationRequested && !mostrarModalProducto && !mostrarModalCliente && !mostrarModalCajero && !mostrarModalLogin)
                    {
                        await InvokeAsync(async () =>
                        {
                            await CargarDatosSilenciosoAsync();
                            StateHasChanged();
                        });
                    }
                }
                catch (TaskCanceledException) { }
                catch (Exception ex)
                {
                    Console.WriteLine("Error en autorrefresco en tiempo real: " + ex.Message);
                }
            }
        }, token);
    }

    private async Task CargarDatosSilenciosoAsync()
    {
        var nuevosProductos = await ApiService.GetProductosAsync();
        var nuevosClientes = await ApiService.GetClientesAsync();
        var nuevasFacturas = await ApiService.GetFacturasAsync();
        var nuevosUsuarios = await ApiService.GetUsuariosAsync();

        if (nuevosProductos.Any()) productos = nuevosProductos;
        if (nuevosClientes.Any()) clientes = nuevosClientes;
        if (nuevasFacturas.Any()) facturas = nuevasFacturas;
        if (nuevosUsuarios.Any()) usuarios = nuevosUsuarios;

        CalcularKPIs();
    }

    public void Dispose()
    {
        _autoRefreshCts?.Cancel();
        _autoRefreshCts?.Dispose();
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            productos = await ApiService.GetProductosAsync();
            clientes = await ApiService.GetClientesAsync();
            facturas = await ApiService.GetFacturasAsync();
            usuarios = await ApiService.GetUsuariosAsync();

            CalcularKPIs();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cargar datos: " + ex.Message);
        }
    }

    private void CalcularKPIs()
    {
        totalFacturasCount = facturas.Count;
        var hoy = DateTime.Today;
        var facturasHoy = facturas.Where(f => f.Fecha.Date == hoy && f.Estado != "Anulada").ToList();
        
        ventasHoyCount = facturasHoy.Count;
        ventasHoyCOP = facturasHoy.Sum(f => f.Total);

        pocoStockCount = productos.Count(p => p.Stock <= 5);
        
        if (productos.Any())
        {
            int saludables = productos.Count(p => p.Stock > 5);
            saludInventarioPct = (int)((double)saludables / productos.Count * 100);
        }
        else
        {
            saludInventarioPct = 100;
        }
    }

    private IEnumerable<string> categoriasDisponibles => productos.Select(p => p.Categoria).Distinct().Where(c => !string.IsNullOrEmpty(c));

    private IEnumerable<Producto> productosFiltrados
    {
        get
        {
            var res = productos.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(busquedaFiltro))
            {
                var q = busquedaFiltro.ToLower();
                res = res.Where(p => p.Nombre.ToLower().Contains(q) || (p.CodigoBarra != null && p.CodigoBarra.ToLower().Contains(q)));
            }
            if (!string.IsNullOrWhiteSpace(categoriaFiltro))
            {
                res = res.Where(p => p.Categoria == categoriaFiltro);
            }
            return res;
        }
    }

    private IEnumerable<Factura> facturasFiltradas
    {
        get
        {
            if (filtroFechaFactura.HasValue)
            {
                return facturas.Where(f => f.Fecha.Date == filtroFechaFactura.Value.Date);
            }
            return facturas;
        }
    }

    private decimal SubtotalCarrito => carrito.Sum(i => i.Subtotal);
    private decimal ImpuestoCarrito => SubtotalCarrito * 0.19m;
    private decimal TotalCarrito => SubtotalCarrito + ImpuestoCarrito;

    private void AgregarAlCarrito(Producto prod)
    {
        if (prod.Stock <= 0) return;

        var existente = carrito.FirstOrDefault(c => c.ProductoId == prod.Id);
        if (existente != null)
        {
            existente.Cantidad += cantidadSeleccionada;
        }
        else
        {
            carrito.Add(new CarritoItemModel
            {
                ProductoId = prod.Id,
                ProductoNombre = prod.Nombre,
                Cantidad = cantidadSeleccionada,
                PrecioUnitario = prod.Precio
            });
        }
        cantidadSeleccionada = 1;
    }

    private void EliminarDelCarrito(CarritoItemModel item)
    {
        carrito.Remove(item);
    }

    private void LimpiarCarrito()
    {
        carrito.Clear();
        cantidadSeleccionada = 1;
    }

    private async Task CobrarVentaPOS()
    {
        if (!carrito.Any() || procesandoVenta) return;

        procesandoVenta = true;
        try
        {
            var dto = new FacturaCreateDto
            {
                ClienteId = clienteSeleccionadoId > 0 ? clienteSeleccionadoId : 1,
                UsuarioId = usuarioLogueado?.Id ?? 1,
                FormaPago = formaPagoSeleccionada,
                PagaCon = TotalCarrito,
                Detalles = carrito.Select(i => new DetalleFacturaCreateDto
                {
                    ProductoId = i.ProductoId,
                    Cantidad = i.Cantidad
                }).ToList()
            };

            var facturaCreada = await ApiService.GenerarFacturaAsync(dto);
            if (facturaCreada != null)
            {
                facturaReciente = facturaCreada;
                LimpiarCarrito();
                await CargarDatosAsync();
                mostrarModalFacturaDoc = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cobrar venta: " + ex.Message);
        }
        finally
        {
            procesandoVenta = false;
        }
    }

    private async Task AnularFactura(Factura fac)
    {
        if (!esAdmin) return;
        try
        {
            var ok = await ApiService.AnularFacturaAsync(fac.Id, "Anulada por Administrador");
            if (ok)
            {
                await CargarDatosAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error anulando factura: " + ex.Message);
        }
    }

    private void AbrirFacturaPdf(Factura fac)
    {
        var url = $"http://localhost:5145/api/Facturas/{fac.Id}/pdf";
        JS.InvokeVoidAsync("open", url, "_blank");
    }

    private void AbrirFacturaTicket(Factura fac)
    {
        var url = $"http://localhost:5145/api/Facturas/{fac.Id}/ticket";
        JS.InvokeVoidAsync("open", url, "_blank");
    }

    private int GetBarHeight(int index)
    {
        if (!facturas.Any()) return 10;
        var ultimas = facturas.Take(10).ToList();
        if (index >= ultimas.Count) return 10;
        
        var max = ultimas.Max(f => f.Total);
        if (max == 0) return 10;

        return (int)((double)(ultimas[index].Total / max) * 50.0 + 10.0);
    }

    private void AbrirModalLogin()
    {
        loginPassword = "";
        loginError = "";
        mostrarModalLogin = true;
    }

    private async Task EjecutarLogin()
    {
        if (string.IsNullOrWhiteSpace(loginUsuario) || string.IsNullOrWhiteSpace(loginPassword))
        {
            loginError = "Por favor ingrese usuario y contraseña.";
            return;
        }

        var usr = await ApiService.LoginAsync(loginUsuario, loginPassword);
        if (usr != null)
        {
            usuarioLogueado = usr;
            mostrarModalLogin = false;

            if (esAdmin)
            {
                activeTab = "admin";
            }
            else
            {
                activeTab = "cajero";
            }
        }
        else
        {
            loginError = "Credenciales incorrectas.";
        }
    }

    private void CerrarSesion()
    {
        usuarioLogueado = null;
        activeTab = "cajero";
    }

    private void AbrirModalNuevoProducto()
    {
        if (!esAdmin) return;
        productoEdicion = new Producto { Categoria = "General", Stock = 10, Precio = 1000 };
        mostrarModalProducto = true;
    }

    private void AbrirModalEditarProducto(Producto p)
    {
        if (!esAdmin) return;
        productoEdicion = new Producto
        {
            Id = p.Id,
            Nombre = p.Nombre,
            CodigoBarra = p.CodigoBarra,
            Categoria = p.Categoria,
            Precio = p.Precio,
            Stock = p.Stock
        };
        mostrarModalProducto = true;
    }

    private async Task GuardarProducto()
    {
        if (!esAdmin || string.IsNullOrWhiteSpace(productoEdicion.Nombre)) return;

        if (productoEdicion.Id == 0)
            await ApiService.CrearProductoAsync(productoEdicion);
        else
            await ApiService.ActualizarProductoAsync(productoEdicion);

        mostrarModalProducto = false;
        await CargarDatosAsync();
    }

    private void AbrirModalNuevoCliente()
    {
        clienteEdicion = new Cliente();
        mostrarModalCliente = true;
    }

    private void AbrirModalEditarCliente(Cliente c)
    {
        if (!esAdmin) return;
        clienteEdicion = new Cliente
        {
            Id = c.Id,
            Nombre = c.Nombre,
            DocumentoIdentidad = c.DocumentoIdentidad,
            Email = c.Email,
            Telefono = c.Telefono
        };
        mostrarModalCliente = true;
    }

    private async Task GuardarCliente()
    {
        if (string.IsNullOrWhiteSpace(clienteEdicion.Nombre)) return;

        if (clienteEdicion.Id == 0)
            await ApiService.CrearClienteAsync(clienteEdicion);
        else
            await ApiService.ActualizarClienteAsync(clienteEdicion);

        mostrarModalCliente = false;
        await CargarDatosAsync();
    }

    private void AbrirModalNuevoCajero()
    {
        if (!esAdmin) return;
        cajeroNuevo = new Usuario { Rol = "Cajero", Activo = true };
        cajeroNuevoPassword = "";
        mostrarModalCajero = true;
    }

    private async Task GuardarCajero()
    {
        if (!esAdmin || string.IsNullOrWhiteSpace(cajeroNuevo.Username) || string.IsNullOrWhiteSpace(cajeroNuevoPassword)) return;
        cajeroNuevo.PasswordHash = cajeroNuevoPassword;

        await ApiService.CrearUsuarioAsync(cajeroNuevo);
        mostrarModalCajero = false;
        await CargarDatosAsync();
    }

    private string FormatCOP(decimal amount)
    {
        var cop = amount < 10000 ? amount * 1000 : amount;
        return cop.ToString("N0");
    }
}
